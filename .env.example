# Copy to .env and fill in. .env is gitignored.
# Get a free key at https://physiology.presagetech.com/
PRESAGE_API_KEY=

# Gemini powers the top 5 predicted communication options.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest; the app falls back automatically
# if the pinned model is unavailable.
GEMINI_MODEL=gemini-flash-latest
